{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://itlegend-co.github.io/scheduling-system/schedule-profile.schema.json",
  "title": "Smart Schedule profile",
  "type": "object",
  "required": ["format", "version", "timezone", "instructions", "entries"],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "format": { "const": "smart-schedule-profile" },
    "version": { "const": 1 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "source": { "type": "object" },
    "timezone": { "const": "Asia/Kuala_Lumpur" },
    "instructions": {
      "type": "object",
      "required": ["preserveUnmentionedEvents"],
      "properties": {
        "preserveUnmentionedEvents": { "const": true }
      },
      "additionalProperties": { "type": "boolean" }
    },
    "rules": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "time": {
      "type": "string",
      "pattern": "^[0-2][0-9]:[0-5][0-9]$"
    },
    "recurrence": {
      "type": "object",
      "required": ["frequency", "interval"],
      "properties": {
        "frequency": { "enum": ["daily", "weekly", "monthly", "yearly"] },
        "interval": { "type": "integer", "minimum": 1 },
        "until": { "$ref": "#/$defs/date" }
      },
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "required": ["id", "section", "type", "title", "status", "details"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "section": { "enum": ["Work profile", "Tasks", "Ad hoc tasks", "Meetings", "Personal"] },
        "type": { "enum": ["task", "follow-up", "reminder", "meeting", "leave", "personal", "work-pattern", "note"] },
        "title": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 },
        "date": { "$ref": "#/$defs/date" },
        "endDate": { "$ref": "#/$defs/date" },
        "deadline": { "$ref": "#/$defs/date" },
        "effectiveDate": { "$ref": "#/$defs/date" },
        "firstWorkingSaturday": { "$ref": "#/$defs/date" },
        "relatedDate": { "$ref": "#/$defs/date" },
        "startTime": { "$ref": "#/$defs/time" },
        "endTime": { "$ref": "#/$defs/time" },
        "preferredStartTime": { "$ref": "#/$defs/time" },
        "allDay": { "type": "boolean" },
        "person": { "type": "string" },
        "location": { "type": "string" },
        "referenceUrl": { "type": "string", "format": "uri" },
        "recurrence": { "$ref": "#/$defs/recurrence" },
        "windows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["startTime", "endTime"],
            "properties": {
              "startTime": { "$ref": "#/$defs/time" },
              "endTime": { "$ref": "#/$defs/time" }
            },
            "additionalProperties": false
          }
        },
        "details": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
