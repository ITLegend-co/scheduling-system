{
  "name": "smart-schedule-windows",
  "version": "1.0.0",
  "description": "Smart Schedule desktop app with native reminders.",
  "author": "ITLegend-co",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "dist": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.itlegend.smartschedule",
    "productName": "Smart Schedule",
    "artifactName": "Smart-Schedule-Setup-1.0.0.exe",
    "files": ["main.cjs", "icon.png", "package.json"],
    "win": {
      "target": [{"target": "nsis", "arch": ["x64"]}],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Smart Schedule"
    }
  }
}
